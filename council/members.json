{
  "settings": {
    "output_language": "Korean",
    "default_rubric": "general",
    "chair_rotation": ["claude", "gemini"],
    "devil_advocate_rotation": ["codex", "gemini", "claude"],
    "min_responses": 2,
    "self_reference_terms": [
      "Claude", "Anthropic", "Gemini", "Google", "ChatGPT", "GPT", "Codex", "OpenAI",
      "Llama", "Meta AI", "Meta", "Muse Spark", "Qwen", "Grok", "xAI", "Perplexity", "Sonar", "DeepSeek"
    ]
  },
  "members": [
    {
      "id": "claude",
      "label": "Claude (Claude Code 서브에이전트)",
      "type": "subagent",
      "enabled": true,
      "paid": false,
      "note": "Claude Max 구독. Claude Code 세션이 서브에이전트로 응답을 채운다. 세션 안에서 claude -p를 호출하면 중첩 세션 차단에 걸릴 수 있어 이 방식을 쓴다."
    },
    {
      "id": "gemini",
      "label": "Gemini (Gemini CLI)",
      "type": "command",
      "command": ["gemini"],
      "output": "stdout",
      "timeout": 600,
      "enabled": true,
      "paid": false,
      "note": "Google AI Pro 구독(하루 1,500회). 프롬프트는 표준입력으로 전달. 비대화식 플래그는 버전마다 다를 수 있으니 gemini --help로 확인."
    },
    {
      "id": "codex",
      "label": "GPT (Codex CLI)",
      "type": "command",
      "command": ["codex", "exec", "--skip-git-repo-check", "--sandbox", "read-only", "--output-last-message", "{output_file}", "-"],
      "output": "file",
      "timeout": 900,
      "enabled": true,
      "paid": false,
      "note": "ChatGPT 무료 계정으로 codex login. '-'는 표준입력에서 프롬프트를 읽는다는 뜻."
    },
    {
      "id": "meta-ai",
      "label": "Meta AI (브라우저 수동)",
      "type": "manual",
      "stages": [1],
      "enabled": true,
      "paid": false,
      "note": "사용자가 meta.ai에 프롬프트를 붙여넣고 답변을 응답 파일에 붙여넣는다. 복사·붙여넣기 부담을 줄이려고 Stage 1에만 참여."
    },
    {
      "id": "perplexity",
      "label": "Perplexity (브라우저 수동)",
      "type": "manual",
      "stages": [1],
      "enabled": true,
      "paid": false,
      "note": "무료 계정. 사용자가 perplexity.ai에 프롬프트를 붙여넣고 답변(출처 포함)을 응답 파일에 붙여넣는다."
    },
    {
      "id": "grok-web",
      "label": "Grok (브라우저 수동)",
      "type": "manual",
      "stages": [1],
      "enabled": true,
      "paid": false,
      "note": "grok.com 무료 계정. 사용자가 프롬프트를 붙여넣고 답변을 응답 파일에 붙여넣는다."
    },
    {
      "id": "llama-local",
      "label": "Llama (로컬 Ollama)",
      "type": "openai_compatible",
      "base_url": "http://localhost:11434/v1",
      "model": "llama3.1:8b",
      "api_key_env": null,
      "timeout": 1200,
      "enabled": false,
      "paid": false,
      "note": "무료지만 내장 GPU PC에서는 느림. ollama pull llama3.1:8b 후 enabled를 true로."
    },
    {
      "id": "claude-cli",
      "label": "Claude (claude -p, 일반 터미널 전용)",
      "type": "command",
      "command": ["claude", "-p"],
      "output": "stdout",
      "unset_env": ["CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"],
      "timeout": 900,
      "enabled": false,
      "paid": false,
      "note": "Claude Code 밖(PowerShell 등)에서 스크립트를 직접 돌릴 때 claude 대신 사용."
    },
    {
      "id": "openrouter-free",
      "label": "오픈모델 (OpenRouter 무료)",
      "type": "openai_compatible",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "CHANGE_ME:free",
      "api_key_env": "OPENROUTER_API_KEY",
      "timeout": 600,
      "enabled": false,
      "paid": false,
      "note": "충전 없이 하루 50회. 무료 모델 목록이 자주 바뀌므로 model을 현재 ':free' ID로 바꿔서 사용."
    },
    {
      "id": "grok",
      "label": "Grok (xAI API)",
      "type": "openai_compatible",
      "base_url": "https://api.x.ai/v1",
      "model": "CHANGE_ME",
      "api_key_env": "XAI_API_KEY",
      "timeout": 600,
      "enabled": false,
      "paid": true,
      "note": "유료. 사용자 요청 전까지 보류."
    },
    {
      "id": "perplexity-api",
      "label": "Perplexity (API)",
      "type": "openai_compatible",
      "base_url": "https://api.perplexity.ai",
      "model": "CHANGE_ME",
      "api_key_env": "PERPLEXITY_API_KEY",
      "timeout": 600,
      "enabled": false,
      "paid": true,
      "note": "유료. 사용자 요청 전까지 보류. 엔드포인트가 Agent API로 바뀌었다는 보도가 있어 연결 전 확인 필요."
    }
  ]
}
